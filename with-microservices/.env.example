# Copy of what setup.js generates as .env — values here are obviously fake.
# Run `node setup.js` against your Authorizer instance to produce a real .env.

# Where all services (and setup.js) reach Authorizer
AUTHORIZER_URL=http://localhost:8080
# The instance's global client ID (--client-id flag). Every JWT this instance
# mints — user or machine — carries it as the `aud` claim.
AUTHORIZER_CLIENT_ID=kbyuFDidLLm280LIwVFiazOqjO3ty8KH
# Only needed by setup.js (--admin-secret flag); never needed at runtime.
# AUTHORIZER_ADMIN_SECRET=admin

GATEWAY_PORT=4000
ORDERS_PORT=4001
BILLING_PORT=4002
ORDERS_URL=http://localhost:4001
BILLING_URL=http://localhost:4002

# Per-service machine identities (service_account clients).
# client_id is a UUID; the secret is shown ONCE by _create_client.
GATEWAY_CLIENT_ID=00000000-0000-4000-8000-00000000fake
GATEWAY_CLIENT_SECRET=fake-gateway-secret-do-not-use
ORDERS_CLIENT_ID=00000000-0000-4000-8000-00000001fake
ORDERS_CLIENT_SECRET=fake-orders-secret-do-not-use
BILLING_CLIENT_ID=00000000-0000-4000-8000-00000002fake
BILLING_CLIENT_SECRET=fake-billing-secret-do-not-use

# Override when the token issuer host differs from AUTHORIZER_URL
# (see README: "The issuer pitfall").
# EXPECTED_ISSUER=http://localhost:8080
