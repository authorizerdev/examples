# Copy of what setup.sh generates. Run ./setup.sh against a running
# Authorizer to produce a real .env — never commit .env.
AUTHORIZER_URL=http://localhost:8080
# The deployment's interactive client ID — the `aud` claim on every token.
AUTHORIZER_CLIENT_ID=kbyuFDidLLm280LIwVFiazOqjO3ty8KH
GATEWAY_PORT=4100
ORDERS_PORT=4101
BILLING_PORT=4102
ORDERS_URL=http://localhost:4101
BILLING_URL=http://localhost:4102
# Service-account clients (created by setup.sh via admin GraphQL):
GATEWAY_CLIENT_ID=
GATEWAY_CLIENT_SECRET=
ORDERS_CLIENT_ID=
ORDERS_CLIENT_SECRET=
BILLING_CLIENT_ID=
BILLING_CLIENT_SECRET=
