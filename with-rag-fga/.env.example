# Copy to .env and fill in. Real environment variables take precedence.

# Base URL of your Authorizer instance
AUTHORIZER_URL=http://localhost:8080

# Client ID (Authorizer dashboard -> Environment, or the --client-id flag).
# The value below matches the authorizer repo's `make dev` server.
AUTHORIZER_CLIENT_ID=kbyuFDidLLm280LIwVFiazOqjO3ty8KH

# Admin secret (--admin-secret flag). Needed by seed.py ONLY — never ship it
# in anything user-facing. `make dev` uses "admin".
AUTHORIZER_ADMIN_SECRET=admin
