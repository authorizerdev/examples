# Authorizer instance (the OpenID Provider). Discovery happens at
# $ISSUER/.well-known/openid-configuration
ISSUER=http://localhost:8080

# The RP's client credentials. With a stock Authorizer instance this is the
# boot-seeded interactive client (--client-id / --client-secret flags).
# `make dev` defaults shown — obviously not for production.
CLIENT_ID=kbyuFDidLLm280LIwVFiazOqjO3ty8KH
CLIENT_SECRET=60Op4HFM0I8ajz0WdiStAbziZ-VFQttXuxixHHs2R7r7-CW8GR79l-mmLqMhc-Sa

# Where this RP runs. The host must be in Authorizer's --allowed-origins
# (redirect_uri is validated against it). `make dev` already allows
# localhost:8090.
RP_PORT=8090
RP_BASE_URL=http://localhost:8090
